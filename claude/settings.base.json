{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f CLAUDE.local.md && echo '--- CLAUDE.local.md ---' && cat CLAUDE.local.md || true"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/claude/bin/settings-symlink-guard.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/claude/bin/progress-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/claude/bin/progress-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "stable",
  "theme": "dark-daltonized",
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen",
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "language": "Japanese",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "voiceEnabled": false
}
